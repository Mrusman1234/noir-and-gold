# ==========================================
# NOIR & GOLD - Root Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build Outputs
.next/
frontend/.next/
out/
build/
dist/
backend/dist/

# TypeScript Build Info
*.tsbuildinfo

# Environment & Secret Files (Protect all .env variants, preserve .env.example)
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
**/.env
**/.env*.local
!.env.example
!**/.env.example

# Local Databases & Backups (SQLite & dumps)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
backend/prisma/*.db
backend/prisma/*.bak

# Logs & Debug Output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lint_output.txt
frontend/lint_output.txt

# OS & Temporary Files
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo

# IDE & Editor Settings
.vscode/
.idea/
.claude/
.qodo/

# Testing & Coverage
coverage/
.nyc_output/

# Verification & Intermediate Artifacts
scripts/rendered_pages/

# Dynamic Customer / Admin Uploads (Preserve structure via .gitkeep)
frontend/public/uploads/**
!frontend/public/uploads/**/
!frontend/public/uploads/**/.gitkeep
