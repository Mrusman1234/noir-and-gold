# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Server-only Prisma datasource for Next.js API routes. Never prefix with NEXT_PUBLIC_.
# Use the backend Prisma SQLite file path; leave spaces literal (do not encode as %20).
# DATABASE_URL=file:C:/absolute/path/to/backend/prisma/dev.db

# Required HMAC key: generate 32 random bytes with an OS cryptographic RNG and hex-encode them.
# Keep the value in ignored .env.local or the deployment secret manager; never commit it.
# Keep the v1 key stable; rotation is unsupported until a versioned verification-key ring is implemented.
# ORDER_VERIFICATION_SECRET=

# Admin portal credentials (server-only). Never hardcode or commit these.
# In production set them as secrets, e.g.:
#   fly secrets set ADMIN_EMAIL=... ADMIN_PASSWORD=... ADMIN_NAME=...
# If ADMIN_EMAIL/ADMIN_PASSWORD are unset the admin portal rejects all logins.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
